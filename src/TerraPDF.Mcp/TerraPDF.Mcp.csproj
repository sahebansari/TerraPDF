<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RollForward>Major</RollForward>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Installable with `dotnet tool install -g TerraPDF.Mcp` or runnable with `dnx TerraPDF.Mcp`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>terrapdf-mcp</ToolCommandName>
    <PackageType>McpServer</PackageType>

    <PackageId>TerraPDF.Mcp</PackageId>
    <Version>1.0.1</Version>
    <Authors>Saheb Ansari</Authors>
    <Title>TerraPDF MCP server</Title>
    <Description>
      Model Context Protocol server for TerraPDF. Gives MCP clients (GitHub Copilot,
      Cursor, Claude Code, VS Code, LangChain via langchain-mcp-adapters) two
      capabilities: create PDF files from a validated JSON document description,
      and look up the verified TerraPDF C# API and recipes while writing code.
    </Description>
    <PackageTags>mcp;model-context-protocol;pdf;ai;agents;copilot;cursor;langchain;terrapdf;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sahebansari/TerraPDF</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/sahebansari/TerraPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerraPDF.Agents\TerraPDF.Agents.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The coding-assistant skill is the single source for the C# guide tool. -->
    <EmbeddedResource Include="..\..\skills\terrapdf\SKILL.md" LogicalName="skill/overview.md" Link="Skill\SKILL.md" />
    <EmbeddedResource Include="..\..\skills\terrapdf\references\api-reference.md" LogicalName="skill/api.md" Link="Skill\api-reference.md" />
    <EmbeddedResource Include="..\..\skills\terrapdf\references\recipes.md" LogicalName="skill/recipes.md" Link="Skill\recipes.md" />
    <EmbeddedResource Include="..\..\skills\terrapdf\references\troubleshooting.md" LogicalName="skill/troubleshooting.md" Link="Skill\troubleshooting.md" />

    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include=".mcp\server.json" Pack="true" PackagePath="\.mcp\" />
    <None Include="..\TerraPDF\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
