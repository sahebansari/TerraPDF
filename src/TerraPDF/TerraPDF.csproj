<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Support .NET 8 (LTS), .NET 9 (STS) and .NET 10 (current LTS) -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <!-- Quality gates -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress missing-XML-doc warnings on intentionally internal/private members -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible / deterministic build -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- NuGet package identity and discoverability -->
    <PackageId>TerraPDF</PackageId>
    <Version>2.3.0</Version>
    <Authors>Saheb Ansari</Authors>
    <Copyright>Copyright © 2025-2026 TerraPDF Contributors</Copyright>
    <Title>TerraPDF - Free C# PDF Library for .NET</Title>
    <Description>
      TerraPDF is a free, open-source (MIT) C# PDF library for .NET. Generate PDF
      documents such as invoices, reports, receipts, labels, certificates, and
      statements from code with a fluent, composable API. Lightweight, zero-dependency,
      and pure managed C#: no native binaries and no HTML-to-PDF browser engine.
      Features include rich text styling, multi-span formatting, Column / Row / Table
      layouts, PNG and JPEG images, borders, page breaks, hyperlinks, headers, footers,
      page numbers, AES-256 encryption, Code128 barcodes, QR codes, custom TrueType
      font embedding with automatic subsetting, vector graphics with rotated text
      labels, elliptical arcs and pie sectors, dashed strokes, linear and radial
      gradient fills, canvas links, bookmarks, and QR codes, positioned images with
      five fit modes, and constant-alpha transparency, full Unicode support, and
      cross-platform .NET 8, 9, and 10 support.
    </Description>
    <PackageTags>pdf;pdf-generation;pdf-library;pdf-document-generator;pdf-reporting;dotnet-pdf;create-pdf;generate-pdf;pdf-writer;pdf-creator;free;open-source;mit;document;reporting;report;fluent-api;invoice;invoice-generator;receipt;statement;table;image;barcode;qrcode;qr-code;code128;encryption;aes-256;no-dependency;zero-dependency;cross-platform;windows;linux;macos;docker;aspnetcore;dotnet;csharp;custom-fonts;truetype;font-embedding;font-subsetting;unicode;vector-graphics;transparency;canvas;image-fit;arc;pie-chart;gradient;dashed-lines;text-rotation;net8;net9;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/sahebansari/TerraPDF</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Version 2.3.0 adds linear and radial gradient fills, dashed strokes on ellipses, rounded rectangles, pie sectors, and arbitrary paths, rounded-rectangle paths, and clickable links, in-document links, bookmarks, and vector QR codes placed at canvas positions. It fixes VectorCanvas.Grid() drawing nothing and ShowIf(false) not hiding chained content. Full changelog: https://github.com/sahebansari/TerraPDF/blob/master/CHANGELOG.md</PackageReleaseNotes>

     <!-- ── Source Link / reproducible build ────────────────────────────── -->
    <RepositoryUrl>https://github.com/sahebansari/TerraPDF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>master</RepositoryBranch>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
    <AssemblyVersion>2.3.0</AssemblyVersion>
    <FileVersion>2.3.0</FileVersion>
  </PropertyGroup>

  <!-- Bundle the README into the NuGet package -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Source Link — maps PDB paths back to GitHub source for debugger step-in -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <!-- Allow unit-test and benchmark projects to access internal APIs -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TerraPDF.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TerraPDF.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
    <ItemGroup>
      <None Include="icon.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
      <None Update="logo.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>

