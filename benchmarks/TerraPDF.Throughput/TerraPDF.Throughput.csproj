<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throughput harness: pages per second, CPU time and memory for realistic documents.
    Uses only TerraPDF's public API so the same program can be built against any version
    of the library (see run-comparison.sh), inside or outside a container.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Server GC is what an ASP.NET Core service in a container uses by default. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraPDF\TerraPDF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\TerraPDF.Sample\header_logo.png" Link="Assets\header_logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\TerraPDF.Sample\small_logo.jpg" Link="Assets\small_logo.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
