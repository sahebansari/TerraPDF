<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <!--
      BenchmarkDotNet requires public, non-sealed benchmark classes with instance
      methods, and owns the lifetime of [GlobalSetup] state. Silence the analyzer
      rules that fight those conventions.
        CA1001: types owning disposable fields should be disposable
        CA1822: mark members as static
        CA1515: consider making public types internal
    -->
    <NoWarn>$(NoWarn);CS1591;CA1001;CA1822;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraPDF\TerraPDF.csproj" />
  </ItemGroup>

  <!-- Reuse the fonts and images already committed for tests and samples. -->
  <ItemGroup>
    <None Include="..\..\tests\TerraPDF.Tests\TestAssets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\TerraPDF.Sample\header_logo.png" Link="Assets\header_logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\TerraPDF.Sample\small_logo.jpg" Link="Assets\small_logo.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\TerraPDF.Sample\alpha_badge.png" Link="Assets\alpha_badge.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
